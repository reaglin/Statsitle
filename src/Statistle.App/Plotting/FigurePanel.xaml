<UserControl x:Class="Statistle.App.Plotting.FigurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
            Background="White" Margin="0,0,0,14" Padding="6">
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="4,6,4,2">
                <Button DockPanel.Dock="Left" Content="Reset view" Click="Reset_Click"
                        Padding="8,3" Margin="0,0,8,0" BorderThickness="0"
                        Background="#E4E8ED" Cursor="Hand" />
                <Button DockPanel.Dock="Left" Content="Save image…" Click="Save_Click"
                        Padding="8,3" BorderThickness="0"
                        Background="#E4E8ED" Cursor="Hand" />
                <TextBlock x:Name="Readout" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
            <sp:WpfPlot x:Name="PlotView" Height="380" MouseMove="PlotView_MouseMove" />
        </DockPanel>
    </Border>
</UserControl>
