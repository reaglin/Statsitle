<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Statistle.Core\Statistle.Core.csproj" />
    <!-- Statistics+: the learning path's tasks and runner (no UI). -->
    <ProjectReference Include="..\Statistle.Learning\Statistle.Learning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared learning engine (learners, PINs, progress, quizzes, the dashboard), from the local feed C:\nuget-local. -->
    <PackageReference Include="Eaglin.Learning.Core" Version="1.1.0" />
    <PackageReference Include="Eaglin.Learning.Reports.Pdf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help ▸ About: Ron's picture beside "Created by Dr. Ron Eaglin". -->
    <Resource Include="Images\dr-ron-eaglin.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Course's content package (Markdown, quizzes, tasks), read from beside the exe. -->
    <None Include="..\..\content\**\*" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version (10.0.19041) gives the program the Windows Store API (Windows.Services.Store) that
         Help ▸ Check for a new version asks; it still runs on every Windows 10/11 the Store supports. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Statistle.ico</ApplicationIcon>
    <!-- Declares PerMonitorV2; without it the app is not DPI aware and WACK warns. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NU1701: ScottPlot.WPF pulls SkiaSharp.Views.WPF, which ships .NET Framework assets and
         is restored through the compatibility fallback. It works on net10.0-windows; the
         warning is noise here and would otherwise be fatal under TreatWarningsAsErrors. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
