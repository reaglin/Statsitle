<Window x:Class="Statistle.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistle — Import data" Height="520" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FA">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
    </Window.CommandBindings>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" x:Name="Summary" Foreground="#6B7680" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SheetLabel" Text="Sheet" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SheetBox" Grid.Column="1" MinWidth="140" Margin="0,0,16,0"
                      ToolTip="The sheet of the workbook to import; the preview below shows it"
                      AutomationProperties.Name="Sheet"
                      SelectionChanged="SheetBox_SelectionChanged" />
            <TextBlock x:Name="FirstLabel" Text="Value column" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,6,0" />
            <ComboBox x:Name="FirstBox" Grid.Column="3" MinWidth="120" Margin="0,0,16,0"
                      SelectionChanged="Column_SelectionChanged" />
            <TextBlock x:Name="SecondLabel" Text="y column" VerticalAlignment="Center" Grid.Column="4" Margin="0,0,6,0" />
            <ComboBox x:Name="SecondBox" Grid.Column="5" MinWidth="120"
                      ToolTip="The column that holds the y values"
                      AutomationProperties.Name="y column"
                      SelectionChanged="Column_SelectionChanged" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="14,4" Margin="8,0,0,0"
                    ToolTip="Closes this window without importing anything (Esc)"
                    BorderThickness="0" Background="#E4E8ED" Cursor="Hand" />
            <Button DockPanel.Dock="Right" x:Name="OkButton" Content="Import" IsDefault="True" Click="Ok_Click"
                    Padding="14,4" BorderThickness="0" FontWeight="SemiBold"
                    Background="#2F3E4C" Foreground="White" Cursor="Hand" />
            <TextBlock x:Name="Outcome" VerticalAlignment="Center" Foreground="#6B7680" FontSize="11" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock Foreground="#6B7680" FontSize="11" TextWrapping="Wrap"
                       Text="The preview shows the first 40 rows of the file. Press F1 for help on importing data." />
        </DockPanel>

        <Border BorderBrush="#D5DBE1" BorderThickness="1" Background="White">
            <DataGrid x:Name="Preview" AutoGenerateColumns="False" IsReadOnly="True"
                      AutomationProperties.Name="Preview of the file"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E6EAEE" BorderThickness="0"
                      RowBackground="White" AlternatingRowBackground="#F7F9FB"
                      CanUserSortColumns="False" CanUserReorderColumns="False" FontSize="12"
                      SelectionUnit="Cell" />
        </Border>
    </DockPanel>
</Window>
