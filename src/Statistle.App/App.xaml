<Application x:Class="Statistle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Statistle.App"
             xmlns:vm="clr-namespace:Statistle.App.ViewModels">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />

        <!-- Workspace palette. Deliberately quiet: the figures carry the colour. -->
        <SolidColorBrush x:Key="RailBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="RailTextBrush" Color="#CBD2D9" />
        <SolidColorBrush x:Key="TreeBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D5DBE1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7680" />
    </Application.Resources>
</Application>
